<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.FloorMapView" styleClass="floor-map-container"
    stylesheets="@../css/floor-map.css">

    <!-- Header: Floor Number and Instructions -->
    <top>
        <VBox spacing="10" alignment="CENTER"
            styleClass="floor-map-header">
            <padding>
                <Insets top="20" bottom="10" />
            </padding>

            <Label fx:id="floorNumberLabel" text="Étage 1"
                styleClass="floor-number-label" />

            <Label fx:id="instructionsLabel"
                text="Choisissez votre prochaine salle"
                styleClass="floor-instructions" />
        </VBox>
    </top>

    <!-- Center: Map Container -->
    <center>
        <StackPane fx:id="mapContainer" styleClass="map-container">
            <Pane fx:id="innerMapPane" />
        </StackPane>
    </center>

    <!-- Bottom: Action Buttons Container -->
    <bottom>
        <VBox fx:id="actionButtonsContainer" spacing="10"
            alignment="CENTER" styleClass="action-buttons">
            <padding>
                <Insets top="10" bottom="20" />
            </padding>
            <Button onAction="#onBackToMainMenuClicked"
                text="Retour au menu principal"
                styleClass="btn,btn-danger,btn-nav" />
        </VBox>
    </bottom>
</BorderPane>
