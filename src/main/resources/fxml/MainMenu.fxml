<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<VBox xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="30"
      styleClass="main-menu"
      stylesheets="@../css/main-menu.css">

    <Label text="BUGÉMON" styleClass="main-title" />

    <Button fx:id="createTeamButton"      text="Gérer mes équipes"         styleClass="btn,btn-primary" prefWidth="380"/>
    <Button fx:id="startAutomaticCombatButton" text="Lancer combat automatique" styleClass="btn,btn-primary" prefWidth="380"/>
    <Button fx:id="startManualCombatButton"    text="Lancer combat manuel"      styleClass="btn,btn-primary" prefWidth="380"/>
    <Button fx:id="noTowerButton"         text="Lancer la NO Tower"        styleClass="btn,btn-primary" prefWidth="380"/>
    <Button fx:id="quitButton"            text="Quitter"                   styleClass="btn,btn-danger"  prefWidth="380"/>

</VBox>
