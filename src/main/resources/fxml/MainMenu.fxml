<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.MainMenuView" alignment="CENTER" spacing="40"
    styleClass="main-menu">

    <Label text="BUGÉMON" styleClass="main-title" />

    <Button fx:id="createTeamButton" onAction="#onCreateTeamClicked"
        text="Créer une éqipe" styleClass="btn,btn-primary,btn-nav" />
    <Button fx:id="editTeamButton" onAction="#onEditTeamClicked"
        text="Gérer mes équipes" styleClass="btn,btn-primary,btn-nav" />
    <Button fx:id="createBugemon" onAction="#onCreateBugemonClicked"
        text="Créer un nouveau Bugemon" styleClass="btn,btn-primary,btn-wide" />
    <Button fx:id="startAutomaticCombatButton"
        onAction="#onStartAutomaticCombatClicked"
        text="Lancer combat automatique" styleClass="btn,btn-primary,btn-nav" />
    <Button fx:id="startManualCombatButton"
        onAction="#onStartManualCombatClicked" text="Lancer combat manuel"
        styleClass="btn,btn-primary,btn-nav" />
    <Button fx:id="noTowerButton" onAction="#onNoTowerClicked"
        text="Lancer la NO Tower" styleClass="btn,btn-primary,btn-nav" />
    <Button fx:id="quitButton" onAction="#onQuitClicked"
        text="Quitter" styleClass="btn,btn-danger,btn-nav" />

</VBox>
