<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>

<?import ulb.views.components.BugemonCardView?>
<?import ulb.models.bugemon.effect.EffectStat?>
<?import ulb.models.bugemon.BugemonType?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.CreateBugemonView" alignment="CENTER"
    spacing="20">
    <HBox alignment="CENTER" spacing="20">
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>
            <BugemonCardView fx:id="bugemonCardView" />
            <Button text="Charger sprite" onAction="#onLoadButtonClicked"
                styleClass="btn,btn-primary,btn-create-bugemon" />
            <Button text="Supprimer sprite"
                onAction="#onRemoveButtonClicked"
                styleClass="btn,btn-danger,btn-create-bugemon" />
            <Button text="Sauvegarder" onAction="#onSaveClicked"
                styleClass="btn,btn-success,btn-create-bugemon" />
            <Button text="Retour au menu principal"
                onAction="#onReturnClicked"
                styleClass="btn,btn-secondary,btn-create-bugemon" />
        </VBox>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40" />
            </padding>
            <TextField fx:id="bugemonNameTextField"
                promptText="Nom de votre Bugemon..." onKeyTyped="#onKeyTyped" />

            <Label text="Choisir le type du Bugemon"
                styleClass="section-label" />
            <HBox spacing="10" alignment="CENTER">

                <fx:define>
                    <ToggleGroup fx:id="typeToggleGroup" />
                </fx:define>

                <ToggleButton text="FLORA"
                    toggleGroup="$typeToggleGroup" onAction="#onTypeClicked"
                    styleClass="btn, attack-FLORA">
                    <userData>
                        <BugemonType fx:constant="FLORA" />
                    </userData>
                </ToggleButton>
                <ToggleButton text="AQUA"
                    toggleGroup="$typeToggleGroup" onAction="#onTypeClicked"
                    styleClass="btn, attack-AQUA">
                    <userData>
                        <BugemonType fx:constant="AQUA" />
                    </userData>
                </ToggleButton>
                <ToggleButton text="PYRO"
                    toggleGroup="$typeToggleGroup" onAction="#onTypeClicked"
                    styleClass="btn, attack-PYRO">
                    <userData>
                        <BugemonType fx:constant="PYRO" />
                    </userData>
                </ToggleButton>
                <ToggleButton text="LITHO"
                    toggleGroup="$typeToggleGroup" onAction="#onTypeClicked"
                    styleClass="btn, attack-LITHO">
                    <userData>
                        <BugemonType fx:constant="LITHO" />
                    </userData>
                </ToggleButton>
            </HBox>

            <Label text="Sélectionner les statistiques" />
            <Label fx:id="healthLabel" />
            <Slider fx:id="healthSlider" min="1" max="100"
                showTickLabels="true" showTickMarks="true" blockIncrement="1">
                <userData>
                    <EffectStat fx:constant="HP" />
                </userData>
            </Slider>

            <Label fx:id="attackLabel" />
            <Slider fx:id="attackSlider" min="1" max="100"
                showTickLabels="true" showTickMarks="true" blockIncrement="1">
                <userData>
                    <EffectStat fx:constant="ATTACK" />
                </userData>
            </Slider>

            <Label fx:id="defenseLabel" />
            <Slider fx:id="defenseSlider" min="1" max="100"
                showTickLabels="true" showTickMarks="true" blockIncrement="1">
                <userData>
                    <EffectStat fx:constant="DEFENSE" />
                </userData>
            </Slider>

            <Label fx:id="initiativeLabel" />
            <Slider fx:id="initiativeSlider" min="1" max="100"
                showTickLabels="true" showTickMarks="true" blockIncrement="1">
                <userData>
                    <EffectStat fx:constant="INITIATIVE" />
                </userData>
            </Slider>

            <Label fx:id="attackCountLabel"
                text="Attaques sélectionnées: 0/3" />
            <ListView fx:id="attackListView" prefHeight="200"
                styleClass="attack-list-view" />
        </VBox>
    </HBox>
</VBox>
