<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import ulb.views.combat.BugemonInfoView?>
<?import ulb.views.combat.ActionMenuView?>
<?import ulb.views.DialogZoneView?>

<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    stylesheets="@../css/combat.css"
>
    <AnchorPane>

        <!-- Trainer (bottom-left): sprite + info side by side -->
        <HBox alignment="TOP_LEFT" spacing="50"
              AnchorPane.bottomAnchor="80" AnchorPane.leftAnchor="80">
            <ImageView fx:id="bugemonTrainerImage"
                       smooth="false" fitHeight="250" fitWidth="250"
                       preserveRatio="true"/>
            <BugemonInfoView fx:id="bugemonTrainerInfo"/>
        </HBox>

        <!-- Opponent (top-right): info + sprite side by side -->
        <HBox alignment="TOP_RIGHT" spacing="50"
              AnchorPane.topAnchor="80" AnchorPane.rightAnchor="80">
            <BugemonInfoView fx:id="bugemonOpponentInfo"/>
            <ImageView fx:id="bugemonOpponentImage"
                       smooth="false" fitHeight="250" fitWidth="250"
                       preserveRatio="true"/>
        </HBox>

        <!-- Action menu (bottom-right) -->
        <ActionMenuView fx:id="actionMenuView"
                        AnchorPane.bottomAnchor="80" AnchorPane.rightAnchor="80"/>

    </AnchorPane>

    <!-- Dialog overlay (shown after each turn) -->
    <DialogZoneView
        fx:id="dialogZoneView"
        visible="false"
        managed="false"
        maxWidth="460"
        StackPane.alignment="CENTER"
    />

</StackPane>
