<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import ulb.views.combat.BugemonInfoView?>
<?import ulb.views.BugemonTeamView?>
<?import ulb.views.ActionMenuView?>
<?import ulb.views.DialogZoneView?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <AnchorPane prefHeight="400.0" prefWidth="600.0">
      <Text fx:id="combatTitle" text="In Combat" AnchorPane.topAnchor="80.0" AnchorPane.leftAnchor="80.0">
         <font>
            <Font name="System Bold" size="40.0"/>
         </font>
      </Text>

      <DialogZoneView fx:id="dialogZoneView" visible="false" managed="false" alignment="CENTER"
            AnchorPane.topAnchor="0.0" 
            AnchorPane.bottomAnchor="0.0" 
            AnchorPane.leftAnchor="0.0" 
            AnchorPane.rightAnchor="0.0"/>

      <!-- Trainer Bugemon Info -->
      <HBox alignment="TOP_LEFT" spacing="50.0" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="80.0">
         <ImageView fx:id="bugemonTrainerImage" smooth="false" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true"
                  preserveRatio="true"/>
         <BugemonInfoView fx:id="bugemonTrainerInfo"/>
      </HBox>

      <!-- Opponent Bugemon Info -->
      <HBox alignment="TOP_RIGHT" spacing="50.0" AnchorPane.topAnchor="80.0" AnchorPane.rightAnchor="80.0">
         <BugemonInfoView fx:id="bugemonOpponentInfo"/>
         <ImageView fx:id="bugemonOpponentImage" smooth="false" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true"
                  preserveRatio="true"/>
      </HBox>

      <!-- Bugemon Team View -->
      <StackPane fx:id="bugemonTeamPane" visible="false" alignment="CENTER_LEFT"  AnchorPane.bottomAnchor="400.0" AnchorPane.leftAnchor="80.0">
         <VBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="windowTitle" text="Bugemon Team" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            <BugemonTeamView fx:id="bugemonTeamView"/>
         </VBox>
      </StackPane>

      <!-- Action Menu -->
      <ActionMenuView fx:id="actionMenuView" AnchorPane.bottomAnchor="80.0" AnchorPane.rightAnchor="80.0"/>
   </AnchorPane>
</StackPane>