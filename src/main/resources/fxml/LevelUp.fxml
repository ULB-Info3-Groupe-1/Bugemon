<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml">

    <center>
        <VBox alignment="CENTER" spacing="20">

            <Label fx:id="levelUpText" textFill="#FFD700" >
                <font>
                    <Font size="28"/>
                </font>
            </Label>

            <Label text="Choose a stat to improve" textFill="#FFD700" >
                <font>
                    <Font size="20"/>
                </font>
            </Label>

            <ImageView fx:id="bugemonImage"
                       fitHeight="200"
                       preserveRatio="true"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="40">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Button fx:id="choice1Button" text="" prefHeight="65.0" prefWidth="230.0" style="-fx-background-color: #008000; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 0;"/>
            <Button fx:id="choice2Button" text="" prefHeight="65.0" prefWidth="230.0" style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 0;"/>
            <Button fx:id="choice3Button" text="" prefHeight="65.0" prefWidth="230.0" style="-fx-background-color: #4682B4; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 0;"/>
        </HBox>
    </bottom>

</BorderPane>
