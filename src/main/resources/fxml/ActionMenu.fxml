<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox"
         xmlns:fx="http://javafx.com/fxml"
         stylesheets="@../css/action-menu.css">

    <GridPane hgap="10" vgap="10" alignment="CENTER_RIGHT" styleClass="action-menu">
        <Button fx:id="action1" styleClass="action-button" minWidth="180"
                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button fx:id="action2" styleClass="action-button" minWidth="180"
                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button fx:id="action3" styleClass="action-button" minWidth="180"
                GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button fx:id="action4" styleClass="action-button" minWidth="180"
                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

</fx:root>
