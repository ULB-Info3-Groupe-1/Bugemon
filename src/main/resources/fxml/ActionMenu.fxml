<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox"
         xmlns:fx="http://javafx.com/fxml"
         stylesheets="@../css/action-menu.css">

    <GridPane hgap="10" vgap="10" alignment="CENTER_RIGHT" styleClass="action-menu"
              prefWidth="500">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" fillWidth="true"/>
            <ColumnConstraints percentWidth="50" fillWidth="true"/>
        </columnConstraints>

        <Button fx:id="action1" styleClass="btn,btn-secondary" maxWidth="Infinity"
                GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
        <Button fx:id="action2" styleClass="btn,btn-secondary" maxWidth="Infinity"
                GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
        <Button fx:id="action3" styleClass="btn,btn-secondary" maxWidth="Infinity"
                GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS"/>
        <Button fx:id="action4" styleClass="btn,btn-secondary" maxWidth="Infinity"
                GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS"/>
    </GridPane>

</fx:root>
