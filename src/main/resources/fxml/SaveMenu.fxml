<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.SaveMenuView" alignment="CENTER" spacing="40"
    styleClass="main-menu">

    <VBox alignment="CENTER" spacing="8">
        <Label text="BUGÉMON" styleClass="main-title" />
        <TextFlow styleClass="save-welcome" textAlignment="CENTER">
            <Text text="Connecté en tant que "
                styleClass="save-welcome-text" />
            <Text fx:id="playerNameText" styleClass="save-welcome-name" />
        </TextFlow>
    </VBox>

    <Button fx:id="newGameButton" onAction="#onNewGameClicked"
        text="Nouvelle partie" styleClass="btn,btn-primary,btn-nav" />
    <Button fx:id="continueButton" onAction="#onContinueClicked"
        text="Continuer" styleClass="btn,btn-primary,btn-nav" />
    <Button fx:id="logoutButton" onAction="#onLogoutClicked"
        text="Se déconnecter" styleClass="btn,btn-secondary,btn-nav" />
    <Button fx:id="quitButton" onAction="#onQuitClicked"
        text="Quitter" styleClass="btn,btn-danger,btn-nav" />

</VBox>
