<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox"
         xmlns:fx="http://javafx.com/fxml"
         alignment="CENTER"
         spacing="6"
         stylesheets="@../css/bugemon-info.css">

    <HBox spacing="8" alignment="CENTER">
        <Label fx:id="bugemonName" styleClass="bugemon-name" text="Name"/>
        <Label fx:id="bugemonType" styleClass="bugemon-type" text="Type"/>
    </HBox>

    <ProgressBar fx:id="bugemonHPBar" prefHeight="16" prefWidth="200" progress="0.0"/>

    <Label fx:id="bugemonHpLabel" styleClass="hp-label" text="0 / 0"/>

</fx:root>
