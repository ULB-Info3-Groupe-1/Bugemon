<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.SkillTreeView"
    styleClass="skill-tree-container">

    <!-- Header -->
    <top>
        <VBox spacing="10" alignment="CENTER"
            styleClass="skill-tree-header">
            <padding>
                <Insets top="20" bottom="10" />
            </padding>
            <Label text="Arbre de compétences"
                styleClass="skill-tree-title" />
        </VBox>
    </top>

    <!-- Center: Tree Canvas -->
    <center>
        <StackPane fx:id="mapContainer" styleClass="map-container">
            <Pane fx:id="innerMapPane" />
        </StackPane>
    </center>

    <!-- Bottom -->
    <bottom>
        <VBox spacing="10" alignment="CENTER" styleClass="action-buttons">
            <padding>
                <Insets top="10" bottom="20" />
            </padding>
            <Button onAction="#onReturnToMainMenuClicked"
                text="Retour au menu principal" styleClass="btn,btn-danger,btn-nav" />
        </VBox>
    </bottom>
</BorderPane>
