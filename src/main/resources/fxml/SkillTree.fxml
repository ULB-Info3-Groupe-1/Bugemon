<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.tower.SkillTreeView"
    styleClass="skill-tree-container" stylesheets="@../css/skill-tree.css">

    <!-- Header -->
    <top>
        <VBox spacing="10" alignment="CENTER"
            styleClass="skill-tree-header">
            <padding>
                <Insets top="40" bottom="40" />
            </padding>
            <Label text="Arbre de compétences"
                styleClass="skill-tree-title" />

            <Label fx:id="availablePoints" text="Points disponibles : 0"
                styleClass="skill-tree-points" />

            <HBox spacing="16" alignment="CENTER" styleClass="skill-legend">
                <Label text="Débloqué"
                    styleClass="skill-legend-item,legend-active" />
                <Label text="Disponible"
                    styleClass="skill-legend-item,legend-available" />
                <Label text="Verrouillé"
                    styleClass="skill-legend-item,legend-locked" />
            </HBox>
        </VBox>
    </top>

    <!-- Center: Tree Canvas -->
    <center>
        <StackPane fx:id="mapContainer" styleClass="map-container">
            <Pane fx:id="innerMapPane" />
        </StackPane>
    </center>

    <!-- Bottom -->
    <bottom>
        <VBox spacing="10" alignment="CENTER" styleClass="action-buttons">
            <padding>
                <Insets top="10" bottom="20" />
            </padding>
            <Button onAction="#onReturnClicked"
                text="Retour au menu principal" styleClass="btn,btn-danger,btn-nav" />
        </VBox>
    </bottom>
</BorderPane>
