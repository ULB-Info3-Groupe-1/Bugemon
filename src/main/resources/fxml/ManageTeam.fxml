<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Text?>

<?import ulb.views.components.AllBugemonsView?>
<?import ulb.views.components.BugemonTeamView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.ManageTeamView">
    <padding>
        <Insets top="8" right="20" bottom="8" left="20" />
    </padding>

    <!-- Title -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="30">
            <BorderPane.margin>
                <Insets top="8" left="16" right="16" bottom="8" />
            </BorderPane.margin>

            <Label text="Sélection de ton équipe"
                styleClass="create-team-title" />

            <VBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Nom de l'équipe à sauvegarder :"
                    styleClass="team-input-label" />
                <TextField fx:id="saveTeamNameInput"
                    styleClass="text-field btn-team" promptText="Nouveau nom..."
                    onAction="#onSaveClicked" />
            </VBox>
        </HBox>
    </top>

    <!-- Team slots (left) + start buttons (right) -->
    <center>
        <HBox spacing="28" alignment="TOP_LEFT">
            <HBox.margin>
                <Insets left="16" top="4" right="16" bottom="4" />
            </HBox.margin>

            <VBox spacing="12">
                <HBox spacing="10">
                    <Label text="Équipe en cours d'édition : " />
                    <Text fx:id="selectedTeamName" />
                </HBox>
                <BugemonTeamView fx:id="bugemonsTeamView" />
            </VBox>

            <VBox spacing="12" alignment="BOTTOM_RIGHT" HBox.hgrow="ALWAYS">
                <VBox.margin>
                    <Insets top="8" />
                </VBox.margin>
                <Label text="Mes équipes" styleClass="section-label" />
                <ListView fx:id="teamListView"
                    styleClass="team-list-view btn-team" prefHeight="160"
                    minHeight="80" onMouseClicked="#onTeamSelected" />

                <Button fx:id="saveTeamButton" text="Sauvegarder"
                    onAction="#onSaveClicked" styleClass="btn btn-success btn-team" />
                <Button fx:id="renameTeamButton" text="Renommer"
                    onAction="#onRenameClicked" styleClass="btn btn-success btn-team" />
                <Button fx:id="modifyTeamButton" text="Modifier l'équipe"
                    onAction="#onModifyTeamClicked"
                    styleClass="btn btn-success btn-team" />
                <Button fx:id="addNewTeamButton" text="Nouvelle équipe +"
                    onAction="#onAddNewTeamClicked"
                    styleClass="btn btn-success btn-team" />
                <Button fx:id="startAutomaticCombatButton"
                    text="Lancer combat automatique"
                    onAction="#onStartAutomaticCombatClicked"
                    styleClass="btn btn-success btn-team" />
                <Button fx:id="startManualCombatButton"
                    text="Lancer combat manuel" onAction="#onStartManualCombatClicked"
                    styleClass="btn btn-success btn-team" />
                <Button fx:id="startTowerCombatButton"
                    text="Lancer combat de la Tour NO"
                    onAction="#onStartTowerCombatClicked"
                    styleClass="btn btn-success btn-team" />
                <Button fx:id="deleteTeamButton" text="Supprimer"
                    onAction="#onDeleteClicked" styleClass="btn btn-danger btn-team" />
                <Button fx:id="returnMainMenuButton"
                    text="Retour au menu principal" onAction="#onReturnMainMenuClicked"
                    styleClass="btn btn-secondary btn-team" />
            </VBox>
        </HBox>
    </center>

    <!-- Available Bugemons (bottom) -->
    <bottom>
        <VBox spacing="8">
            <VBox.margin>
                <Insets left="16" right="16" bottom="8" top="4" />
            </VBox.margin>
            <Label text="Bugémons disponibles" styleClass="section-label" />
            <AllBugemonsView fx:id="allBugemonsGridView" />
        </VBox>
    </bottom>

</BorderPane>
