<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.CombatVictoryView" alignment="CENTER"
    spacing="20">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="VICTOIRE !" styleClass="victory-title" />
    <Button onAction="#onContinueClicked" text="Continuer"
        styleClass="btn,btn-success" minWidth="200" maxWidth="200" />

</VBox>
