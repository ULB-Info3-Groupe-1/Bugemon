<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Text?>

<?import ulb.views.components.AllBugemonsView?>
<?import ulb.views.components.BugemonTeamView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.CreateTeamView" prefWidth="900"
    prefHeight="600">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32" />
    </padding>

    <!-- Title -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="25">
            <BorderPane.margin>
                <Insets top="20" left="30" right="30" bottom="15" />
            </BorderPane.margin>

            <Label text="Sélection de ton équipe"
                styleClass="create-team-title" />

            <VBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Nom de l'équipe à sauvegarder :"
                    styleClass="team-input-label" />
                <TextField fx:id="saveTeamNameInput" prefWidth="220"
                    styleClass="text-field" promptText="Nouveau nom..."
                    onAction="#onSaveClicked" />
            </VBox>
        </HBox>
    </top>

    <!-- Team slots (left) + launch buttons (right) -->
    <center>
        <HBox spacing="24" alignment="TOP_LEFT">
            <HBox.margin>
                <Insets left="24" top="8" right="24" bottom="8" />
            </HBox.margin>

            <VBox spacing="10">
                <HBox spacing="10">
                    <Label text="Ton Équipe: " />
                    <Text fx:id="selectedTeamName" />
                </HBox>
                <BugemonTeamView fx:id="bugemonsTeamView" />
            </VBox>

            <VBox spacing="10" alignment="BOTTOM_RIGHT" HBox.hgrow="ALWAYS">
                <VBox.margin>
                    <Insets top="26" />
                </VBox.margin>
                <Label text="Mes équipes" styleClass="section-label" />
                <ListView fx:id="teamListView"
                    styleClass="team-list-view,btn-panel"
                    onMouseClicked="#onTeamSelected" />

                <Button text="Sauvegarder" onAction="#onSaveClicked"
                    styleClass="btn,btn-success,btn-panel" />
                <Button text="Renommer" onAction="#onRenameClicked"
                    styleClass="btn,btn-success,btn-panel" />
                <Button text="Nouvelle équipe +"
                    onAction="#onAddNewTeamClicked"
                    styleClass="btn,btn-success,btn-panel" />
                <Button text="Supprimer" onAction="#onDeleteClicked"
                    styleClass="btn,btn-danger,btn-panel" />
                <Button text="Retour au menu principal"
                    onAction="#onReturnMainMenuClicked"
                    styleClass="btn,btn-secondary,btn-panel" />
            </VBox>
        </HBox>
    </center>

    <!-- Available Bugemons (bottom) -->
    <bottom>
        <VBox spacing="8">
            <VBox.margin>
                <Insets left="20" right="20" bottom="16" top="4" />
            </VBox.margin>
            <Label text="Bugémons disponibles" styleClass="section-label" />
            <AllBugemonsView fx:id="allBugemonsGridView" />
        </VBox>
    </bottom>

</BorderPane>
