<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<?import ulb.views.AllBugemonsGridView?>
<?import ulb.views.BugemonTeamView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/create-team-menu.css">

    <!-- Title -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="25"> 
            <BorderPane.margin>
                <Insets top="20" left="30" right="30" bottom="15"/>
            </BorderPane.margin>
            
            <Label text="Sélection de ton équipe" styleClass="create-team-title"/>
            
            <VBox spacing="4" alignment="CENTER_LEFT"> 
                <Label text="Nom de l'équipe à sauvegarder :" styleClass="team-input-label"/>
                <TextField fx:id="saveTeamNameInput" 
                            prefWidth="220" 
                            styleClass="text-field"
                            promptText="Nouveau nom..."/>
            </VBox>

            <VBox spacing="4" alignment="CENTER_LEFT"> 
                <Label text="Nom de l'équipe à charger :" styleClass="team-input-label"/>
                <TextField fx:id="loadTeamNameInput" 
                            prefWidth="220" 
                            styleClass="text-field"
                            promptText="Nom de l'équipe..."/>
            </VBox>
        </HBox>
    </top>

    <!-- Team slots (left) + launch buttons (right) -->
    <center>
        <HBox spacing="20" alignment="TOP_LEFT">
            <HBox.margin><Insets left="20" top="10"/></HBox.margin>

            <VBox spacing="8">
                <Label text="Ton équipe" styleClass="section-label"/>
                <BugemonTeamView fx:id="bugemonsTeamView"/>
            </VBox>

            <VBox spacing="10" alignment="BOTTOM_RIGHT" HBox.hgrow="ALWAYS">
                <VBox.margin><Insets top="30" right="30"/></VBox.margin>
                <Button fx:id="returnMainMenuBtn"
                        text="Retour au menu principal"
                        styleClass="menu-button"
                        maxWidth="260" minWidth="260"/>
                <Button fx:id="loadTeamBtn"
                        text="Charger"
                        styleClass="menu-button"
                        maxWidth="260" minWidth="260"/>
                <Button fx:id="saveTeamBtn"
                        text="Sauvegarder"
                        styleClass="menu-button"
                        maxWidth="260" minWidth="260"/>

            </VBox>

        </HBox>
    </center>

    <!-- Available Bugemons (bottom) -->
    <bottom>
        <VBox spacing="6">
            <VBox.margin><Insets left="20" bottom="16"/></VBox.margin>
            <Label text="Bugémons disponibles" styleClass="section-label"/>
            <AllBugemonsGridView fx:id="allBugemonsGridView"/>
        </VBox>
    </bottom>

</BorderPane>
