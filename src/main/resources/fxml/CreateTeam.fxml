<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import ulb.views.AllBugemonsGridView?>
<?import ulb.views.BugemonTeamView?>
<AnchorPane
    maxHeight="-Infinity"
    maxWidth="-Infinity"
    minHeight="-Infinity"
    minWidth="-Infinity"
    prefHeight="500.0"
    prefWidth="800.0"
    stylesheets="@../css/create-team-menu.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
>
   <children>
      <Button
        fx:id="launchAutomaticCombat"
        mnemonicParsing="false"
        styleClass="menu-button"
        text="Lancer combat automatique"
        AnchorPane.rightAnchor="40.0"
        AnchorPane.bottomAnchor="120.0"
    />

        <Button
            fx:id="launchManualCombat"
            mnemonicParsing="false"
            styleClass="menu-button"
            text="Lancer combat manuel"
            AnchorPane.rightAnchor="40.0"
            AnchorPane.bottomAnchor="45.0"
        />

      <Text
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            styleClass="create-team-title"
            text="Sélection de ton équipe"
            textAlignment="CENTER"
            wrappingWidth="300.0"
            AnchorPane.rightAnchor="25.0"
            AnchorPane.topAnchor="20.0"
        >
         <font>
            <Font name="Pixels" size="32.0" />
         </font>
      </Text>

      <AllBugemonsGridView
            fx:id="allBugemonsGridView"
            AnchorPane.bottomAnchor="14.0"
            AnchorPane.leftAnchor="23.0"
        />

      <BugemonTeamView
            fx:id="bugemonsTeamView"
            AnchorPane.topAnchor="14.0"
            AnchorPane.leftAnchor="30.0"
            maxWidth="-2.0"
            maxHeight="-2.0"
        />

   </children>
   
</AnchorPane>
