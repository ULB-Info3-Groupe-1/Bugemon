<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.control.Button?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml"
    spacing="20" alignment="CENTER">

    <VBox styleClass="dialog-zone" spacing="20" alignment="CENTER">
        <TextFlow styleClass="dialog-text">
            <Text fx:id="dialogText" text="Dialog text goes here" />
        </TextFlow>
        <Button fx:id="nextButton" text="Next"
            onAction="#onNextButtonClicked" styleClass="btn, btn-success" />
    </VBox>

</fx:root>
