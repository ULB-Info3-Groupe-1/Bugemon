<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml"
    stylesheets="@../css/action-menu.css">

    <GridPane hgap="10" vgap="10" alignment="CENTER_RIGHT"
        styleClass="action-menu" prefWidth="500">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"
                fillWidth="true" />
            <ColumnConstraints percentWidth="50"
                fillWidth="true" />
        </columnConstraints>

        <Button fx:id="topLeft" text="Attaque"
            styleClass="btn,btn-danger" maxWidth="Infinity"
            GridPane.columnIndex="0" GridPane.rowIndex="0"
            GridPane.hgrow="ALWAYS" onAction="#onAttackClicked" />
        <Button fx:id="topRight" text="Changer de Bugémon"
            styleClass="btn,btn-action-blue" maxWidth="Infinity"
            GridPane.columnIndex="1" GridPane.rowIndex="0"
            GridPane.hgrow="ALWAYS" onAction="#onSwitchClicked" />
        <Button fx:id="bottomLeft" text="Utiliser un objet"
            styleClass="btn,btn-warning" maxWidth="Infinity"
            GridPane.columnIndex="0" GridPane.rowIndex="1"
            GridPane.hgrow="ALWAYS" onAction="#onInventoryClicked" />
        <Button fx:id="bottomRight" text="Abandonner"
            styleClass="btn,btn-secondary" maxWidth="Infinity"
            GridPane.columnIndex="1" GridPane.rowIndex="1"
            GridPane.hgrow="ALWAYS" onAction="#onSurrenderClicked" />
    </GridPane>

</fx:root>
