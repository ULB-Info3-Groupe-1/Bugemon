<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml"
    alignment="CENTER" spacing="6">

    <HBox spacing="8" alignment="CENTER">
        <Label fx:id="bugemonName" styleClass="bugemon-name" text="Name" />
        <Label fx:id="bugemonType" styleClass="bugemon-type" text="Type" />
    </HBox>

    <ProgressBar fx:id="bugemonHPBar" styleClass="hp-bar"
        progress="0.0" />

    <Label fx:id="bugemonHpLabel" styleClass="hp-label" text="0 / 0" />

</fx:root>
