<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="20">

    <Label text="DÉFAITE..."
       style="-fx-font-size: 40px;
              -fx-font-weight: bold;
              -fx-text-fill: #8B0000;" />

    <HBox spacing="50.0" alignment="CENTER">
        <children>
            <Button fx:id="retryButton"          text="Réessayer"               prefHeight="65.0" prefWidth="230.0" style="-fx-background-color: #DC143C; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 0;" />
            <Button fx:id="backToMainMenuButton" text="Retour au menu principal"   prefHeight="65.0" prefWidth="230.0" style="-fx-background-color: #808080; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 0;" />
        </children>
    </HBox>

</VBox>
