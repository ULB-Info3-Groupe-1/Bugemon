<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="ulb.views.CombatDefeatView" alignment="CENTER"
    spacing="20">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="DÉFAITE..." styleClass="defeat-title" />

    <HBox spacing="50.0" alignment="CENTER">
        <children>
            <Button onAction="#onRetryClicked" text="Réessayer"
                styleClass="btn,btn-danger" minWidth="200" maxWidth="200" />
            <Button onAction="#onBackToMainMenuClicked"
                text="Retour au menu principal" styleClass="btn,btn-secondary"
                minWidth="200" maxWidth="200" />
        </children>
    </HBox>

</VBox>
